# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# local env (never commit secrets)
.env
.env.*
!.env.ci
!.env.sample

# System Files
.DS_Store
Thumbs.db

# AgentFS local volumes (SQLite + WAL — exclusive-locked while the app runs)
.agentfs/
**/.agentfs/
*.db-wal
*.db-shm

.nx/cache
.nx/workspace-data
.nx/migrate-runs
.claude/worktrees
.claude/settings.local.json

vitest.config.*.timestamp*

# Next.js
.next
out
