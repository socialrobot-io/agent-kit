{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "noEmit": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "lib": ["es2022"],
    "types": ["node"],
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts"],
  "references": [
    {
      "path": "../../packages/sessions"
    },
    {
      "path": "../../packages/curator"
    },
    {
      "path": "../../packages/core"
    },
    {
      "path": "../../packages/ai"
    }
  ]
}
