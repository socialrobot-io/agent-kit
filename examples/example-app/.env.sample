# 1) AI SDK provider (recommended): @ai-sdk/deepseek
# https://platform.deepseek.com
DEEPSEEK_API_KEY=
# DeepSeek model id (default: deepseek-v4-flash). Also: deepseek-v4-pro
MODEL=deepseek-v4-flash

# 2) Vercel AI Gateway (used only when DEEPSEEK_API_KEY is unset)
# https://vercel.com/ai-gateway
# AI_GATEWAY_API_KEY=
# MODEL=deepseek/deepseek-v4-flash
