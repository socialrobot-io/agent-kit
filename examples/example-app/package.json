{
  "name": "@socialrobot-io/agent-kit-example",
  "version": "0.1.0",
  "private": true,
  "nx": {
    "name": "example",
    "tags": [
      "type:example"
    ],
    "targets": {
      "compile-agent": {
        "command": "bun scripts/compile-agent.ts",
        "options": {
          "cwd": "{projectRoot}"
        },
        "dependsOn": [
          "^build"
        ]
      },
      "dev": {
        "dependsOn": [
          "compile-agent",
          "^build"
        ]
      },
      "build": {
        "dependsOn": [
          "compile-agent",
          "^build"
        ]
      }
    }
  },
  "dependencies": {
    "@socialrobot-io/agent-kit-ai": "workspace:*",
    "@socialrobot-io/agent-kit-core": "workspace:*",
    "@socialrobot-io/agent-kit-curator": "workspace:*",
    "@socialrobot-io/agent-kit-node": "workspace:*",
    "@socialrobot-io/agent-kit-sessions": "workspace:*",
    "@ai-sdk/deepseek": "^3.0.15",
    "@ai-sdk/react": "^4.0.43",
    "agentfs-sdk": "^0.6.4",
    "ai": "^7.0.41",
    "next": "16.2.12",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "@socialrobot-io/agent-kit-sandbox": "workspace:*",
    "bash-tool": "^1.3.18",
    "just-bash": "^3.2.0"
  }
}
