# Vercel AI Gateway: https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=
# Chat model (gateway id). Default: deepseek/deepseek-v4-flash
MODEL=deepseek/deepseek-v4-flash
# Model for curator reviews. Default: MODEL
# CURATOR_MODEL=

# Postgres server to use instead of the in-memory PGlite. Running the demo
# creates agent-kit's tables there (agent_kit_files, _sessions, _messages).
# DATABASE_URL=postgres://user:password@localhost:5432/agentkit
