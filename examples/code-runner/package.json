{
  "name": "@socialrobot-io/agent-kit-code-runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "nx": {
    "name": "code-runner",
    "tags": ["type:example"],
    "targets": {
      "compile-agent": {
        "command": "bun scripts/compile-agent.ts",
        "options": {
          "cwd": "{projectRoot}"
        },
        "dependsOn": ["^build"]
      },
      "start": {
        "command": "bun src/main.ts",
        "options": {
          "cwd": "{projectRoot}"
        },
        "dependsOn": ["compile-agent", "^build"]
      }
    }
  },
  "dependencies": {
    "@socialrobot-io/agent-kit-core": "workspace:*",
    "@socialrobot-io/agent-kit-node": "workspace:*",
    "@socialrobot-io/agent-kit-sandbox": "workspace:*",
    "ai": "^7.0.41"
  }
}
