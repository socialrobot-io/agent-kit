{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmit": true,
    "emitDeclarationOnly": false,
    "types": ["node"],
    "rootDir": ".",
    "outDir": "dist"
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["dist", "out-tsc", "node_modules", "src/**/*.spec.ts"],
  "references": [
    { "path": "../../packages/core" },
    { "path": "../../packages/node" },
    { "path": "../../packages/sandbox" }
  ]
}
