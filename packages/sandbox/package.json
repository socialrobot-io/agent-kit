{
  "name": "@agent-kit/sandbox",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@agent-kit/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "nx": {
    "name": "sandbox",
    "sourceRoot": "packages/sandbox/src",
    "targets": {
      "build": {
        "executor": "@nx/js:swc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "packages/sandbox/dist",
          "main": "packages/sandbox/src/index.ts",
          "tsConfig": "packages/sandbox/tsconfig.lib.json",
          "skipTypeCheck": true,
          "stripLeadingPaths": true
        }
      }
    }
  },
  "dependencies": {
    "@swc/helpers": "~0.5.18",
    "bash-tool": "^1.3.18",
    "just-bash": "^3.2.0",
    "agentfs-sdk": "^0.6.4"
  }
}