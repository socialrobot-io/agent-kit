{
  "name": "@socialrobot-io/agent-kit-sandbox",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@socialrobot-io/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "nx": {
    "name": "sandbox",
    "sourceRoot": "packages/sandbox/src",
    "targets": {
      "build": {
        "executor": "@nx/js:swc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "packages/sandbox/dist",
          "main": "packages/sandbox/src/index.ts",
          "tsConfig": "packages/sandbox/tsconfig.lib.json",
          "skipTypeCheck": true,
          "stripLeadingPaths": true
        }
      }
    }
  },
  "dependencies": {
    "@swc/helpers": "~0.5.18",
    "bash-tool": "^1.3.18",
    "just-bash": "^3.2.0",
    "agentfs-sdk": "^0.6.4"
  },
  "description": "Per-tenant AgentFS volumes and guarded bash toolkit",
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/socialrobot-io/agent-kit.git",
    "directory": "packages/sandbox"
  },
  "bugs": {
    "url": "https://github.com/socialrobot-io/agent-kit/issues"
  },
  "homepage": "https://github.com/socialrobot-io/agent-kit/tree/main/packages/sandbox#readme"
}
