{
  "name": "@socialrobot-io/agent-kit-node",
  "version": "0.3.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@socialrobot-io/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "nx": {
    "name": "node",
    "sourceRoot": "packages/node/src",
    "targets": {
      "build": {
        "executor": "@nx/js:swc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "packages/node/dist",
          "main": "packages/node/src/index.ts",
          "tsConfig": "packages/node/tsconfig.lib.json",
          "skipTypeCheck": true,
          "stripLeadingPaths": true
        }
      }
    }
  },
  "dependencies": {
    "@swc/helpers": "~0.5.18",
    "@socialrobot-io/agent-kit-core": "workspace:*",
    "@socialrobot-io/agent-kit-ai": "workspace:*",
    "@socialrobot-io/agent-kit-sessions": "workspace:*",
    "@socialrobot-io/agent-kit-sandbox": "workspace:*",
    "@socialrobot-io/agent-kit-curator": "workspace:*"
  },
  "peerDependencies": {
    "ai": "^7.0.0"
  },
  "devDependencies": {
    "ai": "^7.0.41"
  },
  "description": "Host composition: createTenantHome wires volume, transcripts, sandbox, sessions, and curator",
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/socialrobot-io/agent-kit.git",
    "directory": "packages/node"
  },
  "bugs": {
    "url": "https://github.com/socialrobot-io/agent-kit/issues"
  },
  "homepage": "https://github.com/socialrobot-io/agent-kit/tree/main/packages/node#readme"
}
